# -----------------------------------------------------------------------------
# oidc_mfa_auth - PRODUCTION settings (docker-compose.prod.yml reads .env.production)
# Copy to .env.production, fill every empty value, never commit it. Prefer a secret manager.
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# false | number of trusted proxy hops in front of the service (never "true")
TRUST_PROXY=1

# Public issuer = externally visible origin of this service (https in production)
ISSUER=https://login.miqaat.com

# --- Existing identity database (PostgreSQL) ---------------------------------
# users / mumin_master / user_eligible are READ ONLY. Auth tables are created or
# extended only by: npm run migration:run
DB_HOST=identity-db.internal
DB_PORT=5432
DB_NAME=identity_db
DB_SCHEMA=miqaat_core
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_POOL_MAX=20

# --- Redis ---------------------------------------------------------------------
REDIS_URL=rediss://redis.internal:6379/0
REDIS_KEY_PREFIX=oidcmfa:

# --- Login rules ---------------------------------------------------------------
# mumin_master.status_id that counts as active (legacy Status_ID = 3)
ACTIVE_STATUS_ID=3
# true  = the ITS ID must be in user_eligible
# false = no eligibility check at all
LOGIN_ELIGIBILITY_CHECK_ENABLED=true
LOGIN_NOT_ELIGIBLE_MESSAGE=You are not eligible to sign in. Please contact your Jamaat office.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_ACCOUNT_LOCK_SECONDS=900
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_IP_WINDOW_SECONDS=300

# --- Core realm sessions -------------------------------------------------------
# Production: __Host- names with COOKIE_SECURE=true. Plain-http local dev: names
# without the prefix and COOKIE_SECURE=false.
SSO_COOKIE_ADMIN=__Host-miqaat-admin-sso
SSO_COOKIE_MUMIN=__Host-miqaat-mumin-sso
COOKIE_SECURE=true
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
# oidc-provider cookie signing keys, comma separated, newest first, 32+ chars each
OIDC_COOKIE_KEYS=
# 32+ chars
CSRF_SECRET=

# --- Token lifetimes (seconds) -------------------------------------------------
AUTH_CODE_TTL_SECONDS=60
ID_TOKEN_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=600
INTERACTION_TTL_SECONDS=600

# --- Logout ----------------------------------------------------------------------
LOGOUT_TOKEN_TTL_SECONDS=120
LOGOUT_RETRY_SCHEDULE_SECONDS=0,5,30,120,600,1800
LOGOUT_WORKER_ENABLED=true
LOGOUT_WORKER_INTERVAL_MS=2000
LOGOUT_HTTP_TIMEOUT_MS=5000

# --- Trusted handoff ------------------------------------------------------------
HANDOFF_REQUEST_TTL_SECONDS=90
HANDOFF_ASSERTION_TTL_SECONDS=60
HANDOFF_RATE_LIMIT_PER_MINUTE=60

# --- Signing keys (RS256) ------------------------------------------------------
# file: private JWKs in SIGNING_KEYS_FILE (development only)
# kms:  AWS KMS keys (private key never leaves KMS) - REQUIRED in production
# Manage with: npm run keys -- list | generate | activate <kid> | retire <kid> | revoke <kid>
SIGNING_KEY_PROVIDER=kms
SIGNING_KEYS_FILE=./.keys/signing-keys.json
AWS_REGION=ap-south-1
# LocalStack / custom endpoint for development only (must be empty in production).
# Credentials come from the normal AWS chain (IAM role in AWS; AWS_ACCESS_KEY_ID/SECRET locally).
AWS_ENDPOINT_URL=

# 32-byte key (base64 or hex): encrypts client secrets and MFA destinations/secrets
DATA_ENCRYPTION_KEY=

# --- MFA ------------------------------------------------------------------------
MFA_DEFAULT_METHOD=EMAIL_OTP
# Platform cap on MFA reuse age (a BU may ask for less with mfa_max_age)
MFA_MAX_AGE_SECONDS=1800
MFA_REQUIRED_FOR_ALL=false
# Honour the legacy users.is_otprequired flag
MFA_HONOR_USER_OTP_FLAG=true
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=10
# 32+ chars
OTP_HMAC_KEY=

# --- Email adapter (default 2FA channel) ----------------------------------------
# smtp | outbox (outbox writes messages to OUTBOX_DIR - development only)
EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Miqaat <no-reply@miqaat.com>

# --- SMS adapter -----------------------------------------------------------------
# disabled | http | outbox
SMS_TRANSPORT=disabled
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=MIQAAT

OUTBOX_DIR=./.outbox

# --- SSR pages -------------------------------------------------------------------
BRAND_TAGLINE=Your Miqaat, in one place
FORGOT_PASSWORD_URL=
