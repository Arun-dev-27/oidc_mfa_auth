# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------------------------
# oidc_mfa_auth - DEVELOPMENT image
#   * all dependencies (incl. dev: nest CLI, ts-node, typeorm CLI for .ts migrations, jest)
#   * source is bind-mounted by docker-compose.dev.yml and recompiled on change (nest --watch)
#   * dev tooling available inside the container: migrations, keys, client:register, mfa:add-factor
# Never use this image in production (see Dockerfile.prod).
# ---------------------------------------------------------------------------------------------
FROM node:22-alpine

ENV NODE_ENV=development \
    # File watching through Windows / macOS bind mounts needs polling.
    TSC_WATCHFILE=DynamicPriorityPolling \
    TSC_WATCHDIRECTORY=DynamicPriorityPolling

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Baseline copy so the image also runs without bind mounts.
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
COPY scripts ./scripts
COPY test ./test
COPY views ./views
COPY public ./public

# Writable locations for dev key file and the Email/SMS outbox (mounted from the host by compose).
RUN mkdir -p /app/.keys /app/.outbox /app/dist && chown -R node:node /app
USER node

EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=3s --start-period=60s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:4000/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npx", "nest", "start", "--watch"]
