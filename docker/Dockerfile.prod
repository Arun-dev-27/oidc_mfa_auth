# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------------------------
# oidc_mfa_auth - PRODUCTION image
#   * multi-stage: compiled JavaScript + production dependencies only (no TypeScript, no dev tools)
#   * runs as the unprivileged "node" user, read-only friendly (only the Email/SMS outbox would
#     write, and the outbox is refused in production)
#   * signing keys come from AWS SSM Parameter Store (KEY_PROVIDER=ssm / auto; a local key file is
#     refused when NODE_ENV=production); no key file is ever baked into the image
#   * schema changes: run the one-shot `migrate` service of docker-compose.prod.yml
# ---------------------------------------------------------------------------------------------

# ---- build ----------------------------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
RUN npx nest build

# ---- production dependencies ------------------------------------------------------------------
# Fresh install without dev and optional dependencies: typeorm lists ts-node as an optional peer,
# which the lockfile marks devOptional - `--omit=dev` alone would keep ts-node + typescript. The only
# other optional packages are pg-cloudflare (Workers only) and @pkgjs/parseargs (old Node fallback).
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --omit=optional --no-audit --no-fund

# ---- runtime --------------------------------------------------------------------------------
FROM node:22-alpine AS runtime
ENV NODE_ENV=production \
    PORT=4000
WORKDIR /app

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./
COPY --chown=node:node views ./views
COPY --chown=node:node public ./public

USER node
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:4000/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/main.js"]
