# -----------------------------------------------------------------------------
# oidc_mfa_auth - Miqaat Core authentication (oidc-provider + SSR login + MFA)
# Copy to .env. Never commit real values.
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# false | number of trusted proxy hops in front of the service (never "true")
TRUST_PROXY=false

# Public issuer = externally visible origin of this service (https in production)
ISSUER=http://localhost:4000

# --- Existing identity database (PostgreSQL) ---------------------------------
# users / mumin_master / user_eligible are READ ONLY. Auth tables are created or
# extended only by: npm run migration:run
DB_HOST=localhost
DB_PORT=5451
DB_NAME=identity_db
DB_SCHEMA=miqaat_core
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=20

# --- Redis ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6393/2
REDIS_KEY_PREFIX=oidcmfa:

# --- Login rules ---------------------------------------------------------------
# mumin_master.status_id that counts as active (legacy Status_ID = 3)
ACTIVE_STATUS_ID=3
# true  = the ITS ID must be in user_eligible
# false = no eligibility check at all
LOGIN_ELIGIBILITY_CHECK_ENABLED=true
LOGIN_NOT_ELIGIBLE_MESSAGE=You are not eligible to sign in. Please contact your Jamaat office.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_ACCOUNT_LOCK_SECONDS=900
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_IP_WINDOW_SECONDS=300

# --- Core realm sessions -------------------------------------------------------
# Production: __Host- names with COOKIE_SECURE=true. Plain-http local dev: names
# without the prefix and COOKIE_SECURE=false.
SSO_COOKIE_ADMIN=__Host-miqaat-admin-sso
SSO_COOKIE_MUMIN=__Host-miqaat-mumin-sso
COOKIE_SECURE=true
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
# oidc-provider cookie signing keys, comma separated, newest first, 32+ chars each
OIDC_COOKIE_KEYS=
# 32+ chars
CSRF_SECRET=
# Client authentication accepted at /token and the handoff API (comma separated).
# Standard: client_secret_basic (Authorization: Basic base64(client_id:client_secret)).
# Optional: private_key_jwt, client_secret_post.
CLIENT_AUTH_METHODS=client_secret_basic

# --- Token lifetimes (seconds) -------------------------------------------------
AUTH_CODE_TTL_SECONDS=60
ID_TOKEN_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=600
INTERACTION_TTL_SECONDS=600

# --- Logout ----------------------------------------------------------------------
# Signed back-channel logout lifetime, and delivery retry delays (attempt 1, 2, ...)
LOGOUT_TOKEN_TTL_SECONDS=120
LOGOUT_RETRY_SCHEDULE_SECONDS=0,5,30,120,600,1800
LOGOUT_WORKER_ENABLED=true
LOGOUT_WORKER_INTERVAL_MS=2000
LOGOUT_HTTP_TIMEOUT_MS=5000

# --- Trusted handoff ------------------------------------------------------------
HANDOFF_REQUEST_TTL_SECONDS=90
HANDOFF_ASSERTION_TTL_SECONDS=60
HANDOFF_RATE_LIMIT_PER_MINUTE=60

# --- Signing keys (RS256) ------------------------------------------------------
# Where the PRIVATE key set (JWKs + rotation status NEXT/ACTIVE/RETIRING/RETIRED) is stored:
#   auto  AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY set -> SSM Parameter Store, otherwise the local file (default)
#   ssm   SSM Parameter Store SecureString at SSM_SIGNING_KEYS_PARAMETER (AWS environments)
#   file  local file at SIGNING_KEYS_FILE (development; refused in production)
#   kms   legacy: keys inside AWS KMS (signing through KMS Sign)
# Tokens are always signed in this process with RS256; the private key is never put in this file.
# Manage with: npm run keys -- list | generate | activate <kid> | retire <kid> | revoke <kid>
KEY_PROVIDER=auto
# Local key file (git-ignored: .keys/ and config/keys/)
SIGNING_KEYS_FILE=./.keys/signing-keys.json
# SSM parameter; empty -> /miqaatcoredev/<dev|test|prod>/auth/jwks-private-key
SSM_SIGNING_KEYS_PARAMETER=/miqaatcoredev/dev/auth/jwks-private-key
# Optional customer KMS key that encrypts the SecureString (empty -> AWS managed key aws/ssm)
SSM_KMS_KEY_ID=
# How long "auto" waits for AWS credentials before choosing the local file
KEY_PROVIDER_DETECT_TIMEOUT_MS=3000
AWS_REGION=ap-south-1
# LocalStack / custom endpoint for development only (must be empty in production).
AWS_ENDPOINT_URL=
# env   (default) credentials ONLY from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below; ~/.aws is never read
# chain full AWS default chain (profiles, SSO, ECS / EC2 IAM role) - only if you run with an IAM role
AWS_CREDENTIALS_SOURCE=env
# AWS credentials for SSM (the IAM user needs ssm:GetParameter, plus ssm:PutParameter for
# "npm run keys"). Only your region, access key and secret key are needed. Leave empty to use an
# IAM role / AWS profile instead. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 32-byte key (base64 or hex): encrypts client secrets and MFA destinations/secrets
DATA_ENCRYPTION_KEY=

# --- MFA ------------------------------------------------------------------------
MFA_DEFAULT_METHOD=EMAIL_OTP
# Platform cap on MFA reuse age (a BU may ask for less with mfa_max_age)
MFA_MAX_AGE_SECONDS=1800
MFA_REQUIRED_FOR_ALL=false
# Honour the legacy users.is_otprequired flag
MFA_HONOR_USER_OTP_FLAG=true
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=10
# 32+ chars
OTP_HMAC_KEY=
# TESTING ONLY: a fixed code (e.g. 123456) accepted for every member and every method
# (Email OTP, SMS OTP, TOTP) besides the real code. Empty = off. Refused in production.
MFA_STATIC_OTP=

# --- Email adapter (default 2FA channel) ----------------------------------------
# smtp | outbox (outbox writes messages to OUTBOX_DIR - development only)
# Brevo example: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false (STARTTLS),
# SMTP_USER=<login>@smtp-brevo.com, SMTP_PASSWORD=<SMTP key>. EMAIL_FROM must be a sender verified in
# Brevo, and the server's IP must be allowed under Brevo Security -> Authorised IPs (if that is enabled).
# Check with: npm run email:test [-- --to you@example.com]
EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Miqaat <no-reply@miqaat.com>

# --- SMS adapter -----------------------------------------------------------------
# disabled | http | outbox
SMS_TRANSPORT=disabled
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=MIQAAT

OUTBOX_DIR=./.outbox

# --- SSR pages -------------------------------------------------------------------
BRAND_TAGLINE=Your Miqaat, in one place
FORGOT_PASSWORD_URL=
# Google Search Console ownership token: only the content="..." value of the
# <meta name="google-site-verification"> tag. Printed on every Core page when set.
GOOGLE_SITE_VERIFICATION=
